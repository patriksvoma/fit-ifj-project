import ifj26.*

@main def main(): Unit =
  var x: Int = 7
  var y: String = "ahoj"
  var z: Double = 1.65
  var w: Boolean = true

  x = -x
  print(x)
  print(" ")
  x = 7

  z = 5 * z
  print(toStr(z))
  print(" ")
  z = 1.65

  x = x / 2
  print(x)
  print(" ")
  x = 7

  z = x / z
  print(toStr(z))
  print(" ")
  z = 1.65

  z = x + 15.78
  print(toStr(z))
  print(" ")

  x = x - 10
  print(x)
  print(" ")

  y = y + toStr(w)
  print(y)

