import ifj26.*

@main def main(): Unit =
  var x: Int = 7
  var y: String = "ahoj"
  var z: Double = 1.65
  var w: Boolean = true

  x = -x
  print(x )

  x = 5 * z
  print(x )

  x = 15 / 2
  print(x )

  z = x / z
  print(toStr(z))
  print(" ")

  z = z + 15.78
  print(toStr(z))
  print(" ")

  x = x - 10
  print(x )

  y = y + toStr(w)
  print(y)

